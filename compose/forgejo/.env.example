# Copy to .env on the server and fill in. .env is gitignored; this file is not.
#
#     cp .env.example .env
#
# Note this stack has no secrets in .env — SQLite means no database password,
# and the runner's registration token lives in /srv/forgejo-runner/data/.runner
# rather than here. The pattern is established now so the next service, which
# will have secrets, has somewhere obvious to put them.

# Hostname Forgejo advertises in clone URLs and web links. Must be reachable
# from wherever you clone — the NetBird FQDN works from the desktop, the
# MacBook, and anywhere else enrolled in the mesh.
FORGEJO_DOMAIN=channa-homelab.netbird.cloud

# Host interface to publish on. The NetBird mesh IP: reachable from enrolled
# peers, invisible to the LAN and the internet.
#
# Do not set this to 0.0.0.0. Do not leave it unset — daemon.json defaults
# published ports to 127.0.0.1, so an empty value silently produces a service
# only the server itself can reach.
BIND_IP=100.108.127.155
