# Copy to .env on the server and fill in.
#
# This stack has no secrets: SQLite needs no database password, and the runner's
# registration token lives in /srv/forgejo-runner/data/.runner. The pattern is
# established here so the next service has an obvious place for them.

# Hostname Forgejo advertises in clone URLs and web links. Must be reachable from
# wherever you clone.
FORGEJO_DOMAIN=channa-homelab.netbird.cloud

# Host interface to publish on. Never 0.0.0.0, and never unset — an empty value
# silently produces a loopback-only service.
BIND_IP=100.108.127.155
