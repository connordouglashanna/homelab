# Copy to .env in this directory and fill in. Workstation-only: nothing here is
# ever populated on the server -- see ansible/README.md#naming-the-ssh-key.
#
# Ansible does not read .env on its own. Export it before running a playbook,
# from this directory:
#
#     set -a; source .env; set +a

# Filename of your private SSH key, resolved by inventory.yml under ~/.ssh/.
# The filename only, not a path -- `inventory.yml` supplies the directory, which
# is what lets one inventory work from any workstation regardless of what that
# machine calls its key.
#
# Unset, `ansible all -m ping` fails with the undef() message from inventory.yml
# rather than a confusing authentication error.
HOMELAB_SSH_KEY=id_ed25519_homelab
# current key names include: id_ed25519_homelab_m5_mba, id_ed25519_homelab_ncased